// RANG BIRANGI - Production E-Commerce Schema
// Prisma + SQLite (project standard stack)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============= AUTH & USERS =============

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  phone         String?  @unique
  name          String?
  passwordHash  String
  role          String   @default("CUSTOMER") // CUSTOMER | ADMIN
  avatarUrl     String?
  status        String   @default("ACTIVE") // ACTIVE | SUSPENDED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  cart          Cart?
  wishlist      Wishlist?
  notifications Notification[]
  activityLogs  ActivityLog[]
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String
  email     String?
  houseNo   String
  building  String?
  street    String
  area      String?
  landmark  String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============= CATALOG =============

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  iconName    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id              String       @id @default(cuid())
  name            String
  slug            String       @unique
  sku             String       @unique
  description     String
  material        String?
  weight          String?
  careInstructions String?
  categoryId      String
  category        Category     @relation(fields: [categoryId], references: [id])
  price           Float
  compareAtPrice  Float?
  discountPercent Float        @default(0)
  stock           Int          @default(0)
  lowStockThreshold Int        @default(5)
  images          String      // JSON array of URLs (comma-separated)
  videos          String?     // JSON array of URLs
  colors          String?     // JSON array of color names
  sizes           String?     // JSON array of size names
  rating          Float        @default(0)
  reviewCount     Int          @default(0)
  tags            String?     // comma-separated tags
  isFeatured      Boolean      @default(false)
  isTrending      Boolean      @default(false)
  isNewArrival    Boolean      @default(false)
  isFlashSale     Boolean      @default(false)
  isBestSeller    Boolean      @default(false)
  isHandmade      Boolean      @default(false)
  isPublished     Boolean      @default(true)
  seoTitle        String?
  seoDescription  String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  orderItems      OrderItem[]
  reviews         Review[]
  wishlistItems   WishlistItem[]
  cartItems       CartItem[]
}

// ============= SHOPPING =============

model Cart {
  id        String      @id @default(cuid())
  userId    String      @unique
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  color     String?
  size      String?
  savedForLater Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model WishlistItem {
  id          String    @id @default(cuid())
  wishlistId  String
  wishlist    Wishlist  @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  createdAt   DateTime  @default(now())
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  rating    Int
  title     String?
  comment   String?
  imageUrl  String?
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  adminReply String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============= ORDERS & PAYMENTS =============

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  items           OrderItem[]
  addressSnapshot String      // JSON of address at order time
  subtotal        Float
  discount        Float       @default(0)
  shippingCost    Float       @default(0)
  tax             Float       @default(0)
  total           Float
  status          String      @default("PENDING_PAYMENT")
  // PENDING_PAYMENT | CONFIRMED | PACKED | SHIPPED | OUT_FOR_DELIVERY | DELIVERED | CANCELLED | RETURNED | REFUNDED
  paymentMethod   String      // UPI | COD
  paymentStatus   String      @default("PENDING") // PENDING | PAID | FAILED | REFUNDED
  paymentRef      String?
  trackingNumber  String?
  courier         String?
  notes           String?
  invoiceNumber   String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  payment         Payment?
  shipment        Shipment?
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  name         String
  sku          String
  price        Float
  quantity     Int
  color        String?
  size         String?
  image        String?
  total        Float
}

model Payment {
  id          String   @id @default(cuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id])
  method      String   // UPI | COD
  amount      Float
  status      String   @default("PENDING") // PENDING | SUCCESS | FAILED | REFUNDED
  txnRef      String?
  upiId       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Shipment {
  id            String   @id @default(cuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id])
  courier       String   @default("Delhivery")
  trackingNumber String?
  status        String   @default("INITIATED")
  // INITIATED | PICKED_UP | IN_TRANSIT | OUT_FOR_DELIVERY | DELIVERED | RTO
  estimatedDelivery DateTime?
  shippedAt    DateTime?
  deliveredAt  DateTime?
  history      String?  // JSON of status updates
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============= CMS =============

model Banner {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  imageUrl    String
  linkUrl     String?
  buttonText  String?
  position    String   @default("HERO") // HERO | MIDDLE | FOOTER
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  startAt     DateTime?
  endAt       DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HomepageSection {
  id          String   @id @default(cuid())
  key         String   @unique // hero, categories, trending, new_arrivals, flash_sale, featured, handmade, best_sellers, reviews, newsletter
  title       String
  subtitle    String?
  isEnabled   Boolean  @default(true)
  sortOrder   Int      @default(0)
  config      String?  // JSON config (filters, limits, etc.)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // INFO | ORDER | PROMO | SYSTEM
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String?
  entityId  String?
  metadata  String?  // JSON
  createdAt DateTime @default(now())
}
